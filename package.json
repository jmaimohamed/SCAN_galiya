{
  "name": "galia-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-port.mjs 3006",
    "dev": "next dev -H 0.0.0.0 -p 3006",
    "predev:3007": "node scripts/check-port.mjs 3007",
    "dev:3007": "next dev -H 0.0.0.0 -p 3007",
    "build": "prisma generate && next build",
    "prestart": "node scripts/check-port.mjs 3006",
    "start": "next start -H 0.0.0.0 -p 3006",
    "prestart:3007": "node scripts/check-port.mjs 3007",
    "start:3007": "next start -H 0.0.0.0 -p 3007",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:all": "vitest run --project unit && vitest run --project integration --no-file-parallelism",
    "db:create": "tsx scripts/db-create.ts",
    "db:create:test": "tsx scripts/db-create.ts --test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "tsx scripts/db-migrate-test.ts",
    "db:status": "prisma migrate status",
    "create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
