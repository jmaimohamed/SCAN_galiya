# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (the database is created by `npm run db:create` if missing).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/Scann?schema=public"

# Only for `npm run test:integration` — a SEPARATE database whose name must end with _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/Scann_test?schema=public"

# Exact origins (scheme://host:port) workstations use to open the app, comma-separated.
# Requests from any other origin are refused (CSRF protection) and other Host headers get 421.
APP_TRUSTED_ORIGINS="http://localhost:3006,http://localhost:3007,http://127.0.0.1:3006,http://127.0.0.1:3007"

# Session lifetime (hours) and idle timeout (minutes).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Force the Secure cookie flag ("true"/"false"). Default: Secure when the request origin is https://.
# SESSION_COOKIE_SECURE=true

# Login rate limiting (failures per window).
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
